# /etc/dastyar.env — settings of the hosted assistant. No secrets: visitors bring their own Liara key.
# (systemd env file: comments only on their own lines)

# empty key → judge mode (recordings, simulated fixes); a real key → a live session on that visitor's account
LIARA_REPLAY=auto
# never 1 on a public server (it opens a developer route)
LIARA_DEV=0
LIARA_PUBLIC_ORIGIN=https://dastyar.frontage.store
# action log, daily caps, uploaded project copies (deleted with the session)
LIARA_DATA_DIR=/var/lib/dastyar
# the docker bridge gateway: reachable by the Caddy container, not from outside
HOST=172.20.0.1
PORT=3140
# only the proxy can reach HOST:PORT, so its X-Forwarded-* headers are trusted
FORWARDED_ALLOW_IPS=*
# no AI spend per visitor; judge mode shows recorded model answers
LLM_ENABLED=0
# shared instance: never push one visitor's alerts to an owner's phone
LIARA_WATCH_PUSH=0
